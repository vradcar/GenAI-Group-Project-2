{
  "servers": [
    {
      "name": "filesystem",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/path/to/your/project"
      ],
      "env": null
    },
    {
      "name": "tavily",
      "command": "npx",
      "args": [
        "-y",
        "tavily-mcp@0.1.4"
      ],
      "env": {
        "TAVILY_API_KEY": "YOUR_TAVILY_API_KEY"
      }
    },
    {
      "name": "rag",
      "command": "python",
      "args": [
        "src/forgepilot/rag_server/server.py"
      ],
      "env": null
    }
  ]
}