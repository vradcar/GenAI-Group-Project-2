# Core
FORGEPILOT_NAME=ForgePilot
LOG_LEVEL=INFO
WORKSPACE_ROOT=.
EXECUTION_MODE=confirm

# Model provider
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.1:8b
TEMPERATURE=0.1
MAX_TOKENS=2048

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Cloud providers (set only what you use)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# MCP
MCP_CONFIG_PATH=./configs/mcp.servers.example.json
MCP_TIMEOUT_SECONDS=30

# External MCP server keys
TAVILY_API_KEY=
CONTEXT7_API_KEY=

# Local RAG MCP
RAG_MCP_URL=http://127.0.0.1:8010
RAG_COLLECTION=langchain_docs
RAG_TOP_K=5
